##############################################################################
# Application Setting
##############################################################################
APP_NAME=approval-hub-service
APP_VERSION=0.1.0

# Server (the container sets SERVER_ADDRESS=0.0.0.0)
# Local, no-login deployment: 127.0.0.1 keeps the service off the network
SERVER_ADDRESS=127.0.0.1
SERVER_PORT=3001
# SERVER_CONTEXT=approval-hub-service

# CORS: comma-separated origins. Empty = cross-origin requests are refused
CORS_ORIGINS=http://localhost:8742,http://localhost:3001

# Debugging: true only on a developer machine (adds `error` and `module` to error responses)
ENABLE_DEBUGGING=false

# Throttle: DEFAULT_THROTTLE_LIMIT requests per DEFAULT_THROTTLE_TOTAL seconds, per client
DEFAULT_THROTTLE_TOTAL=60
DEFAULT_THROTTLE_LIMIT=120

# Swagger
SWAGGER_ENABLED=false
SWAGGER_TITLE=Approval Hub Service
SWAGGER_DESCRIPTION=API service for Approval Hub: GitHub pull requests as approval requests, decisions and audit trail
SWAGGER_VERSION=${APP_VERSION}

##############################################################################
# PostgreSQL
##############################################################################
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5435
POSTGRES_DB=approval_hub
POSTGRES_USER=approval_hub
POSTGRES_PASSWORD=approval_hub
# POSTGRES_SCHEMA=public
# POSTGRES_SSL=false
# POSTGRES_POOL_SIZE=10

##############################################################################
# GitHub (read-only, unauthenticated)
##############################################################################
# Public repositories only; requests are sent without any account or token,
# so no real user credential is ever involved. Rate limit: 60 requests/hour per IP.
# (GITHUB_API_TOKEN is intentionally absent; if rate limits ever matter, set a
# throwaway account's fine-grained token with public-read scope only.)
# Comma-separated owner/name entries the board watches.
GITHUB_REPOSITORIES=nestjs/nest,RZRStudios69/MAI_Stroke_xAI_SHAP

##############################################################################
# Local git mirrors (approve merges here; nothing is pushed)
##############################################################################
# Directory the service keeps its mirror clones in. Relative to the service root.
GIT_MIRRORS_PATH=git-mirrors

##############################################################################
# JWT (reserved: this service is @Public everywhere, the key is checked but unused)
##############################################################################
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=
# Token lifetime in seconds
JWT_EXPIRES_IN=3600
